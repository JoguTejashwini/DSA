class Solution:
    def eventualSafeNodes(self, graph: List[List[int]]) -> List[int]:
        n=len(graph)
        vis=[0]*n
        path=[0]*n
        check=[0]*n
        def dfs(node):
            vis[node]=1
            path[node]=1
            for nei in graph[node]:
                if vis[nei]==0:
                    if dfs(nei):
                        return True
                elif path[nei]==1:
                    return True
            check[node]=1
            path[node]=0
            return False

        for i in range(n):
            if vis[i]==0:
                dfs(i)
        res=[]
        for i in range(n):
            if check[i]==1:
                res.append(i)
        return res

