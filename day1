//brute force approach
def maxSubarraySum(self, arr, k):
    n=len(arr)
    maxsum=0
    for i in range(n-k+1):
        s=0
        for j in range(i,i+k):
            s+=arr[j]
        maxsum=max(maxsum,s)
    return maxsum
        

//prefix sum approach
def maxSubarraySum(self, arr, k):
    n=len(arr)
    ps=[0]*(n+1)
    ms=0
    for i in range(n):
        ps[i+1]=ps[i]+arr[i]
        for i in range(n-k+1):
            cs=ps[i+k]-ps[i]
        ms=max(ms,cs)
    return ms       


