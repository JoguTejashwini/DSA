class Solution:
    def maxScore(self, cardPoints: List[int], k: int) -> int:
        n=len(cardPoints)
        ms=0
        for i in range(k+1):
            s=0
            for left in range(i):
                s+=cardPoints[left]
            for r in range(k-i):
                s+=cardPoints[n-1-r]
            ms=max(s,ms)
        return ms



optimal solution 
class Solution:
    def maxScore(self, cardPoints: List[int], k: int) -> int:
        n=len(cardPoints)
        wss=n-k
        ws=sum(cardPoints[:wss])
        total=sum(cardPoints)
        mws=ws
        for i in range(wss,n):
            ws+=cardPoints[i]-cardPoints[i-wss]
            mws=min(mws,ws)
        return total-mws
