class Solution:
    def rotateTheBox(self, boxGrid: List[List[str]]) -> List[List[str]]:
        m = len(boxGrid)
        n = len(boxGrid[0])

        # Step 1: simulate gravity
        for r in range(m):
            empty = n - 1

            for c in range(n - 1, -1, -1):

                if boxGrid[r][c] == '*':
                    empty = c - 1

                elif boxGrid[r][c] == '#':
                    boxGrid[r][c] = '.'
                    boxGrid[r][empty] = '#'
                    empty -= 1

        # Step 2: rotate
        ans = [[0] * m for _ in range(n)]

        for r in range(m):
            for c in range(n):
                ans[c][m - 1 - r] = boxGrid[r][c]

        return ans
